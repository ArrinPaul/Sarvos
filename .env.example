# Environment Variables Template
# Copy this file to .env.local for local development.
# Do not store production secrets or actual credentials in this repository.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enquiry delivery via Resend (https://resend.com). All three are required;
# until they are set the contact form reports that delivery is unavailable.
# RESEND_API_KEY=""
# CONTACT_NOTIFICATION_EMAIL=""   # inbox that receives enquiries
# CONTACT_FROM_EMAIL=""           # verified sender, e.g. "SARVOS <enquiries@your-verified-domain>"
